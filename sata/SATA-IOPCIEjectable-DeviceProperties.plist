<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>DeviceProperties</key>
	<dict>
		<key>Add</key>
		<dict>
			<!-- SATA 控制器路径: PciRoot(0x0)/Pci(0x17,0x0) -->
			<!-- ACPI 路径: \_SB.PC00.SAT1 -->
			<!-- 注入 IOPCIEjectable 属性, AppleAHCIPort 读取此属性后设置 AHCI-Ejectable=1 -->
			<key>PciRoot(0x0)/Pci(0x17,0x0)</key>
			<dict>
				<key>IOPCIEjectable</key>
				<data>AQ==</data>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
